# =============================================================================
# HomeSpark Root .gitignore
# =============================================================================

# --- Environment variables & Secrets (CRITICAL) ---
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
client_secret*.json
service_account*.json
credentials.json
token.json
*session*.json
firebase-adminsdk*.json

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Node.js & Frontend ---
node_modules/
.next/
out/
.turbo/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tsbuildinfo
next-env.d.ts

# --- Audio & Large Model Weights (DO NOT UPLOAD) ---
*.wav
*.mp3
*.ogg
*.flac
*.m4a
*.pth
*.pt
*.bin
*.safetensors
*.onnx
*.ckpt
*.tflite

# --- Temporary & Scratch files ---
sftp_batch.txt
*.log
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db

# --- IDE & Editors ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
